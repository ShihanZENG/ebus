# DataLab API 配置；密钥从服务端安全渠道获取，不要提交真实密钥。
DATALAB_API_KEY=
DATALAB_API_BASE_URL=https://47.107.76.124/data-lab

DATABASE_URL=postgresql+psycopg://erp:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:15432/erp
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
ERP_SESSION_HOURS=8

# LIM 网关治理：留空为单进程内存模式；多实例必须设置同一 Redis。
# 本地 compose Redis: redis://127.0.0.1:16379/0
LIM_REDIS_URL=
LIM_REQUESTS_PER_MINUTE=60
LIM_MAX_CONCURRENCY=3
LIM_DAILY_TOKEN_BUDGET=1000000
LIM_MAX_ATTEMPTS=2
LIM_CIRCUIT_THRESHOLD=3
LIM_CIRCUIT_SECONDS=30

# 采购 Agent 真实模型（Chat Completions + tools），地址须来自服务商控制台。
PURCHASE_AGENT_LLM_BASE_URL=
PURCHASE_AGENT_LLM_API_KEY=
PURCHASE_AGENT_LLM_MODEL=
# 百炼非流式调用建议关闭 thinking；其他服务保留 false。
PURCHASE_AGENT_LLM_DISABLE_THINKING=false
# DataLab API 配置；密钥从服务端安全渠道获取，不要提交真实密钥。
DATALAB_API_KEY=
DATALAB_API_BASE_URL=https://47.107.76.124/data-lab

